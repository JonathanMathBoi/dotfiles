#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        hrm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>; // Allow for holding a key to spam with intention
            require-prior-idle-ms = <125>; // Prevent errors from fast typing
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =========================================================================
        // LAYER 0: BASE HRM
        // Replace the A,S,D,F and J,K,L,SEMI with your hml/hmr behaviors
        // =========================================================================
        base_layer {
            bindings = <
    &kp ESC     &kp F1      &kp F2      &kp F3       &kp F4       &kp F5     &kp F6     &kp F7       &kp F8       &kp F9      &kp F10        &kp F11    &kp F12    &kp DEL    &kp C_MUTE
    &kp GRAVE   &kp N1      &kp N2      &kp N3       &kp N4       &kp N5     &kp N6     &kp N7       &kp N8       &kp N9      &kp N0         &kp MINUS  &kp EQUAL  &kp BSPC   &kp PG_UP
    &kp TAB     &kp Q       &kp W       &kp E        &kp R        &kp T      &kp Y      &kp U        &kp I        &kp O       &kp P          &kp LBKT   &kp RBKT   &kp BSLH   &kp PG_DN
    &kp CLCK    &hrm LALT A &hrm LGUI S &hrm LCTRL D &hrm LSHFT F &kp G      &kp H      &hrm RSHFT J &hrm RCTRL K &hrm RGUI L &hrm RALT SEMI &kp SQT    &kp RET               &kp HOME
    &kp LSHFT           &kp Z       &kp X         &kp C       &kp V     &kp B      &kp N          &kp M      &kp COMMA    &kp DOT       &kp FSLH    &kp RSHFT             &kp UP
    &kp LCTRL  &kp LGUI   &kp LALT                                    &kp SPACE                                           &kp RALT      &mo 2       &to 3      &kp LEFT   &kp DOWN   &kp RIGHT
    // Keychron Hardware Control
    &none      &kc SEL_BLE           &kc SEL_PPT           &kc SEL_USB           &kc BATCHG
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // =========================================================================
        // LAYER 1: SPACE / NUMBER LAYER
        // Accessible by holding Space (or whichever trigger you choose)
        // =========================================================================
        space_layer {
            bindings = <
    &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
    &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
    &trans     &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT  &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &trans     &trans     &trans     &trans
    &trans     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &trans     &trans                &trans
    &trans                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans                &trans
    &trans     &trans     &trans                           &trans                                      &trans     &trans     &trans     &trans     &trans     &trans
    // Keychron Hardware Control
    &none      &trans           &trans           &trans           &trans
            >;
            sensor-bindings = <&trans>;
        };

        // =========================================================================
        // LAYER 2: FN LAYER
        // Media controls, RGB controls, Bluetooth Profiles
        // =========================================================================
        fn_layer {
            bindings = <
    &trans     &kp C_BRI_DN    &kp C_BRI_UP    &trans       &trans   &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &kp C_PREV &kp C_PP   &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans &rgb_ug RGB_TOG
    &trans     &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2 &trans   &trans          &trans           &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
    &trans     &rgb_ug RGB_TOG &rgb_ug RGB_MOD &trans       &trans   &trans          &trans           &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
    &trans     &trans     &trans     &trans     &trans     &trans    &trans          &trans           &trans     &trans     &trans     &trans     &trans                &kp END
    &trans                &trans     &trans     &trans     &trans    &kc BATINFO &trans     &trans     &trans     &trans     &trans     &trans                &trans
    &trans     &trans     &trans                           &trans                                      &trans     &trans     &trans     &trans     &trans     &trans
    // Keychron Hardware Control
    &none      &trans           &trans           &trans           &trans
            >;
            sensor-bindings = <&trans>;
        };

        // =========================================================================
        // LAYER 3: GAMING LAYER
        // Standard QWERTY with NO hold-taps, ensuring zero input delay
        // =========================================================================
        gaming_layer {
            bindings = <
    &kp ESC    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12    &kp DEL    &kp C_MUTE
    &kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS  &kp EQUAL  &kp BSPC   &kp PG_UP
    &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp LBKT   &kp RBKT   &kp BSLH   &kp PG_DN
    &kp CLCK   &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT    &kp RET               &kp HOME
    &kp LSHFT             &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT             &kp UP
    &kp LCTRL  &kp LGUI   &kp LALT                         &kp SPACE                                   &kp RALT   &mo 2      &to 0      &kp LEFT   &kp DOWN   &kp RIGHT
    // Keychron Hardware Control
    &none      &kc SEL_BLE           &kc SEL_PPT           &kc SEL_USB           &kc BATCHG
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
